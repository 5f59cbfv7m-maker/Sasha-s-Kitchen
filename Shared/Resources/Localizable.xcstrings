            "value": "Le frigo est vide"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il frigo è vuoto"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "冷蔵庫は空です"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "냉장고가 비어 있습니다"
          }
        },
        "pt-BR": {
