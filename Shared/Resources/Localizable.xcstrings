            "value": "Adds a product to the Sasha’s Kitchen shopping list."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade un producto a la lista de la compra de Sasha’s Kitchen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute un produit à la liste de courses de Sasha’s Kitchen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiunge un prodotto alla lista della spesa di Sasha’s Kitchen."
          }
        },
        "ja": {
