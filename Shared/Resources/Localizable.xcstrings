    "Продукт пропадёт и из рецептов, где он есть: %lld.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Produkt verschwindet auch aus den Rezepten, in denen es vorkommt: %lld."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The product will also disappear from the recipes that use it: %lld."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El producto también desaparecerá de las recetas que lo usan: %lld."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le produit disparaîtra aussi des recettes qui l’utilisent : %lld."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il prodotto sparirà anche dalle ricette che lo usano: %lld."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この食品を使っているレシピからも消えます：%lld件。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 식품을 쓰는 레시피에서도 사라집니다: %lld개."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O produto também vai sumir das receitas que o usam: %lld."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สินค้านี้จะหายไปจากสูตรที่ใช้ด้วย: %lld สูตร"
          }
        },
        "zh-Hans": {
