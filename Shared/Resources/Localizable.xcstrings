          "stringUnit": {
            "state": "translated",
            "value": "Receita"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สูตร"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "菜谱"
          }
        }
      }
    },
    "Рецепт без ингредиентов не сохранится — из него нечего списывать.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Rezept ohne Zutaten wird nicht gespeichert – es gäbe nichts abzubuchen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A recipe without ingredients can’t be saved — there’d be nothing to deduct."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una receta sin ingredientes no se guardará: no habría nada que descontar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une recette sans ingrédients ne sera pas enregistrée — il n’y aurait rien à déduire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una ricetta senza ingredienti non si salva: non ci sarebbe niente da scalare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "材料のないレシピは保存できません。差し引くものがないからです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "재료가 없는 레시피는 저장되지 않습니다. 차감할 것이 없으니까요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma receita sem ingredientes não é salva — não haveria nada para descontar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สูตรที่ไม่มีวัตถุดิบจะบันทึกไม่ได้ — ไม่มีอะไรให้หัก"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有食材的菜谱无法保存——没有可扣除的东西。"
          }
        }
      }
    },
    "Рецепт добавится в «Рецепты», продукты — в каталог, а чего не хватает — сразу в «Для покупки».": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Rezept kommt zu „Rezepte“, die Produkte in den Katalog und was fehlt direkt zu „Einkaufen“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The recipe goes to Recipes, its products to the catalog, and whatever is missing straight to To Buy."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La receta irá a Recetas, sus productos al catálogo y lo que falte directamente a Por comprar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La recette ira dans Recettes, ses produits au catalogue, et ce qui manque directement dans À acheter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La ricetta finisce in Ricette, i prodotti nel catalogo e ciò che manca direttamente in Da comprare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レシピは「レシピ」に、食品はカタログに、足りないものはそのまま「買い物」に入ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "레시피는 ‘레시피’로, 식품은 카탈로그로, 부족한 것은 바로 ‘살 것’으로 들어갑니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A receita vai para Receitas, os produtos para o catálogo e o que faltar direto para Para comprar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สูตรจะไปอยู่ใน “สูตรอาหาร” สินค้าไปที่แคตตาล็อก และของที่ขาดไปที่ “ต้องซื้อ” ทันที"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "菜谱进入“菜谱”，食材进入目录，缺少的直接进入“待购买”。"
          }
        }
      }
    },
