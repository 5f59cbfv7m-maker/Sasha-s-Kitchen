    "Рецепты карточками: видео или фото, короткое описание, автор.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rezepte als Karten: Video oder Foto, kurze Beschreibung, Autor."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recipes as cards: video or photo, a short description, the author."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recetas en tarjetas: vídeo o foto, descripción breve y autor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des recettes en cartes : vidéo ou photo, courte description, auteur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ricette a schede: video o foto, breve descrizione, autore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カード形式のレシピ：動画または写真、短い説明、作者。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카드 형식의 레시피: 동영상 또는 사진, 짧은 설명, 작성자."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Receitas em cartões: vídeo ou foto, descrição curta, autor."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สูตรแบบการ์ด: วิดีโอหรือรูป คำอธิบายสั้น ผู้เขียน"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "卡片式菜谱：视频或照片、简短说明、作者。"
          }
        }
      }
    },
    "Россия и СНГ": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Russland & GUS"
          }
        },
