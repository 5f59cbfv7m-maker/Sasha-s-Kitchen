    "«%@» уже есть в каталоге — пополните остаток на вкладке «Холодильник».": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ ist schon im Katalog – fülle den Vorrat im Tab „Kühlschrank“ auf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” is already in the catalog — top it up on the Fridge tab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» ya está en el catálogo: repón el stock en la pestaña Nevera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » est déjà dans le catalogue — complétez le stock dans l’onglet Frigo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» è già nel catalogo: rifornisci la scorta nella scheda Frigo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」はもうカタログにあります。「冷蔵庫」タブで在庫を補充してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘%@’은(는) 이미 카탈로그에 있습니다. ‘냉장고’ 탭에서 재고를 채우세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” já está no catálogo — reponha o estoque na aba Geladeira."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” มีอยู่ในแคตตาล็อกแล้ว — เติมสต็อกได้ที่แท็บ “ตู้เย็น”"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”已在目录中——请在“冰箱”标签页补充库存。"
          }
        }
      }
    },
