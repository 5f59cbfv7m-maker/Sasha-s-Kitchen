    "Кнопка «В Напоминания» на вкладке «Для покупки» создаёт список «%@» с настоящими чекбоксами.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Taste „In Erinnerungen“ im Tab „Einkaufen“ legt eine Liste „%@“ mit echten Häkchen an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The “To Reminders” button on the To Buy tab creates a “%@” list with real checkboxes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El botón «A Recordatorios» de la pestaña Por comprar crea una lista «%@» con casillas de verdad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le bouton « Vers Rappels » de l’onglet À acheter crée une liste « %@ » avec de vraies cases à cocher."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il pulsante «In Promemoria» nella scheda Da comprare crea una lista «%@» con vere caselle di spunta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「買い物」タブの「リマインダーへ」ボタンで、本物のチェックボックスつきの「%@」リストを作成します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘살 것’ 탭의 ‘미리 알림으로’ 버튼은 진짜 체크박스가 있는 ‘%@’ 목록을 만듭니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O botão “Para Lembretes” da aba Para comprar cria uma lista “%@” com caixas de seleção de verdade."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปุ่ม “ไปที่เตือนความจำ” ในแท็บ “ต้องซื้อ” จะสร้างรายการ “%@” ที่มีช่องติ๊กจริง"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“待购买”标签页上的“存到提醒事项”按钮会创建一个带真正勾选框的“%@”列表。"
          }
        }
      }
    },
