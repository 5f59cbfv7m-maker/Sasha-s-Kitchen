    "Вибро работает на iPhone; на iPad и Mac основной отклик — звук и анимация.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibration gibt es auf dem iPhone; auf iPad und Mac antwortet die App mit Ton und Animation."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Haptics work on iPhone; on iPad and Mac the feedback is sound and animation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La vibración funciona en el iPhone; en el iPad y el Mac la app responde con sonido y animación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les vibrations fonctionnent sur iPhone ; sur iPad et Mac, l’app répond par le son et l’animation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La vibrazione funziona su iPhone; su iPad e Mac l’app risponde con suono e animazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "振動はiPhoneで使えます。iPadとMacではサウンドとアニメーションでお知らせします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "진동은 iPhone에서 작동하며, iPad와 Mac에서는 소리와 애니메이션으로 알려 줍니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A vibração funciona no iPhone; no iPad e no Mac o app responde com som e animação."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การสั่นใช้ได้บน iPhone ส่วนบน iPad และ Mac แอปจะตอบสนองด้วยเสียงและแอนิเมชัน"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "振动仅在 iPhone 上可用；在 iPad 和 Mac 上以声音和动画反馈。"
          }
        }
      }
    },
