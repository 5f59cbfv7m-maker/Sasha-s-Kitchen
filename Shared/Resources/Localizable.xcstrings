    "Добавьте первый продукт кнопкой «плюс» в правом верхнем углу.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge dein erstes Produkt mit der Plus-Taste oben rechts hinzu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add your first product with the “plus” button in the top right corner."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade tu primer producto con el botón «más» de arriba a la derecha."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez votre premier produit avec le bouton « plus » en haut à droite."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi il primo prodotto con il pulsante «più» in alto a destra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "右上の「＋」ボタンで最初の食品を追加しましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오른쪽 위의 ‘+’ 버튼으로 첫 식품을 추가하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione o primeiro produto com o botão “mais” no canto superior direito."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่มสินค้าแรกด้วยปุ่ม “+” ที่มุมขวาบน"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用右上角的“+”按钮添加第一种食材。"
          }
        }
      }
    },
    "Добавьте первый продукт кнопкой «плюс» или начните со стартового набора продуктов и рецептов.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge dein erstes Produkt mit dem Plus-Button hinzu oder beginne mit dem Startset aus Produkten und Rezepten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add your first product with the “plus” button or start with the starter set of products and recipes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade tu primer producto con el botón «más» o empieza con el kit inicial de productos y recetas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez votre premier produit avec le bouton « plus » ou commencez par le kit de départ de produits et de recettes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi il primo prodotto con il pulsante «più» o inizia dal kit iniziale di prodotti e ricette."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「＋」ボタンで最初の食材を追加するか、食材とレシピのスターターセットから始めましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘+’ 버튼으로 첫 재료를 추가하거나 재료와 레시피가 담긴 스타터 세트로 시작하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione o primeiro produto com o botão “mais” ou comece pelo kit inicial de produtos e receitas."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่มวัตถุดิบแรกด้วยปุ่ม “บวก” หรือเริ่มจากชุดเริ่มต้นที่มีวัตถุดิบและสูตรอาหาร"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用“加号”按钮添加第一样食材，或者从包含食材和菜谱的入门套装开始。"
          }
        }
      }
    },
