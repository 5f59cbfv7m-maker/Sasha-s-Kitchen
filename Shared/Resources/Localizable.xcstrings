    "Всё, что нужно рецептам, есть в холодильнике. Список наполнится сам, когда продукты начнут заканчиваться.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles, was deine Rezepte brauchen, ist im Kühlschrank. Die Liste füllt sich von selbst, wenn etwas ausgeht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything your recipes need is in the fridge. The list fills itself as products run out."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo lo que necesitan tus recetas está en la nevera. La lista se llena sola cuando algo se acaba."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout ce qu’il faut pour vos recettes est au frigo. La liste se remplit d’elle-même quand les produits s’épuisent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto ciò che serve alle tue ricette è in frigo. La lista si riempie da sola quando qualcosa finisce."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レシピに必要なものはすべて冷蔵庫にあります。食品が減ってくると、リストは自動で埋まります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "레시피에 필요한 재료가 모두 냉장고에 있습니다. 식품이 떨어지기 시작하면 목록이 저절로 채워집니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo o que suas receitas pedem está na geladeira. A lista se preenche sozinha quando algo acaba."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทุกอย่างที่สูตรต้องใช้มีอยู่ในตู้เย็นแล้ว รายการจะเติมเองเมื่อของเริ่มหมด"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "菜谱需要的东西冰箱里都有。食材快用完时，清单会自动填好。"
          }
        }
      }
    },
