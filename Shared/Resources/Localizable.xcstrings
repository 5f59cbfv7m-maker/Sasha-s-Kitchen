    "Холодильник пуст": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kühlschrank ist leer"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The fridge is empty"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
