    "Сбросить данные?": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Daten zurücksetzen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reset data?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Restablecer los datos?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réinitialiser les données ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ripristinare i dati?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "データをリセットしますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "데이터를 재설정할까요?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Redefinir os dados?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รีเซ็ตข้อมูลไหม"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要重置数据吗？"
          }
        }
      }
    },
    "Сведения о продуктах — из открытой базы Open Food Facts. Отправляется только сам штрихкод.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Produktdaten kommen aus der offenen Datenbank Open Food Facts. Gesendet wird nur der Barcode."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Product details come from the open Open Food Facts database. Only the barcode itself is sent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los datos vienen de la base abierta Open Food Facts. Solo se envía el código de barras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les informations viennent de la base ouverte Open Food Facts. Seul le code-barres est envoyé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I dati arrivano dal database aperto Open Food Facts. Viene inviato solo il codice a barre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "食品の情報はオープンデータベースOpen Food Factsから取得します。送信するのはバーコードだけです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "식품 정보는 공개 데이터베이스 Open Food Facts에서 가져옵니다. 바코드만 전송됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os dados vêm da base aberta Open Food Facts. Só o código de barras é enviado."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อมูลสินค้ามาจากฐานข้อมูลเปิด Open Food Facts โดยส่งไปแค่บาร์โค้ด"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "食材信息来自开放数据库 Open Food Facts。只会发送条形码本身。"
          }
        }
      }
    },
    "Свои продукты, рецепты и журнал будут удалены без возможности вернуть.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Produkte, Rezepte und das Protokoll werden endgültig gelöscht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your products, recipes and log will be deleted permanently."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus productos, recetas y diario se borrarán para siempre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos produits, recettes et journal seront supprimés définitivement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi prodotti, le ricette e il diario saranno eliminati per sempre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分の食品、レシピ、記録は完全に削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 식품, 레시피, 기록이 영구적으로 삭제됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus produtos, receitas e diário serão apagados para sempre."
          }
        },
        "th": {
