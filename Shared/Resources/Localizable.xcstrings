    "Сброс удалит все остатки, свои рецепты, список покупок и журнал — на всех ваших устройствах, — а затем разложит заново стартовый набор продуктов и рецептов.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Zurücksetzen löscht alle Bestände, eigenen Rezepte, die Einkaufsliste und das Protokoll – auf all deinen Geräten – und lädt dann das Startset aus Produkten und Rezepten neu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resetting deletes all stock, your recipes, the shopping list and the log — on all your devices — and then reloads the starter set of products and recipes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al restablecer se borran todas las existencias, tus recetas, la lista de la compra y el diario —en todos tus dispositivos— y se vuelve a cargar el kit inicial de productos y recetas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La réinitialisation supprime tous les stocks, vos recettes, la liste de courses et le journal — sur tous vos appareils — puis recharge le kit de départ de produits et de recettes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il ripristino elimina tutte le scorte, le tue ricette, la lista della spesa e il diario — su tutti i tuoi dispositivi — e poi ricarica il kit iniziale di prodotti e ricette."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リセットすると、すべての在庫、自分のレシピ、買い物リスト、記録が（すべてのデバイスで）削除され、食材とレシピのスターターセットが読み込み直されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "초기화하면 모든 재고, 내 레시피, 장보기 목록, 기록이 모든 기기에서 삭제되고 재료와 레시피 스타터 세트를 다시 불러옵니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Redefinir apaga todo o estoque, suas receitas, a lista de compras e o diário — em todos os seus aparelhos — e depois recarrega o kit inicial de produtos e receitas."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การรีเซ็ตจะลบสต็อกทั้งหมด สูตรของคุณ รายการซื้อของ และบันทึก ในทุกอุปกรณ์ จากนั้นโหลดชุดเริ่มต้นของวัตถุดิบและสูตรอาหารใหม่"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重置会在你的所有设备上删除全部库存、自己的菜谱、购物清单和记录，然后重新载入包含食材和菜谱的入门套装。"
          }
        }
      }
    },
    "Сбросить": {
      "localizations": {
        "de": {
