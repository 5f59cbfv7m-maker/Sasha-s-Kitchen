    "Уведомления для Sasha’s Kitchen запрещены в настройках устройства — разрешите их там.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitteilungen für Sasha’s Kitchen sind in den Geräteeinstellungen ausgeschaltet – erlaube sie dort."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications for Sasha’s Kitchen are turned off in the device settings — allow them there."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notificaciones de Sasha’s Kitchen están desactivadas en los ajustes del dispositivo; actívalas allí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notifications de Sasha’s Kitchen sont désactivées dans les réglages de l’appareil — autorisez-les là-bas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le notifiche di Sasha’s Kitchen sono disattivate nelle impostazioni del dispositivo: attivale lì."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Sasha’s Kitchenの通知がデバイスの設定でオフになっています。設定で許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기 설정에서 Sasha’s Kitchen 알림이 꺼져 있습니다. 설정에서 허용해 주세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As notificações do Sasha’s Kitchen estão desativadas nos ajustes do aparelho — permita-as lá."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การแจ้งเตือนของ Sasha’s Kitchen ถูกปิดในการตั้งค่าอุปกรณ์ โปรดอนุญาตที่นั่น"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Sasha’s Kitchen 的通知已在设备设置中关闭，请在那里允许。"
