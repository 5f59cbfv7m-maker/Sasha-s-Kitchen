    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit der Kamera scannst du Barcodes von Produkten und legst sie ohne Tippen in den Kühlschrank."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The camera is used to scan product barcodes and add them to the fridge without typing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cámara sirve para escanear códigos de barras de productos y añadirlos a la nevera sin escribir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’appareil photo sert à scanner les codes-barres des produits pour les ajouter au frigo sans les taper."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La fotocamera serve a scansionare i codici a barre dei prodotti e aggiungerli al frigo senza digitare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "食品のバーコードをスキャンして、入力せずに冷蔵庫に追加するためにカメラを使います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "식품 바코드를 스캔해 입력 없이 냉장고에 추가하는 데 카메라를 사용합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A câmera serve para ler códigos de barras de produtos e colocá-los na geladeira sem digitar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Камера нужна, чтобы сканировать штрихкоды продуктов и добавлять их в холодильник без ручного ввода."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้กล้องสแกนบาร์โค้ดสินค้าเพื่อใส่เข้าตู้เย็นโดยไม่ต้องพิมพ์"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "相机用于扫描食材条形码，无需手动输入即可放进冰箱。"
          }
        }
      }
    },
    "NSRemindersFullAccessUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit Zugriff auf Erinnerungen legt die App deine Einkaufsliste als Liste „Einkaufen“ mit echten Häkchen an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reminders access lets the app put your shopping list into a “Shopping” list with real checkboxes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con acceso a Recordatorios la app guarda tu lista de la compra en una lista «Comprar» con casillas de verdad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accès à Rappels permet de placer votre liste de courses dans une liste « Courses » avec de vraies cases à cocher."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con l’accesso a Promemoria l’app mette la lista della spesa in una lista «Spesa» con vere caselle di spunta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リマインダーへのアクセスで、買い物リストを本物のチェックボックスつきの「買うもの」リストに入れられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "미리 알림에 접근하면 장보기 목록을 진짜 체크박스가 있는 ‘장보기’ 목록으로 넣을 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com acesso aos Lembretes o app coloca sua lista de compras numa lista “Comprar” com caixas de seleção de verdade."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ к Напоминаниям нужен, чтобы складывать список покупок в список «Купить» с настоящими чекбоксами."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อเข้าถึงเตือนความจำได้ แอปจะใส่รายการซื้อของลงในรายการ “ซื้อของ” ที่มีช่องติ๊กจริง"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许访问提醒事项后，应用会把购物清单放进带真正勾选框的“购物”列表。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
