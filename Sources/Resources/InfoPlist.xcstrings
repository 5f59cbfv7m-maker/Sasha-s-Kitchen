    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit der Kamera scannst du Barcodes von Produkten und fotografierst Rezeptseiten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The camera is used to scan product barcodes and photograph recipe pages."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cámara sirve para escanear códigos de barras de productos y fotografiar páginas de recetas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’appareil photo sert à scanner les codes-barres des produits et à photographier des pages de recettes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La fotocamera serve per scansionare i codici a barre dei prodotti e fotografare pagine di ricette."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラは食材のバーコードの読み取りと、レシピのページの撮影に使います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카메라는 제품 바코드를 스캔하고 레시피 페이지를 촬영하는 데 사용됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A câmera é usada para ler códigos de barras de produtos e fotografar páginas de receitas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Камера нужна, чтобы сканировать штрихкоды продуктов и фотографировать страницы с рецептами."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้กล้องเพื่อสแกนบาร์โค้ดสินค้าและถ่ายรูปหน้าสูตรอาหาร"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "相机用于扫描商品条形码和拍摄菜谱页面。"
          }
        }
      }
    },
    "NSRemindersFullAccessUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit Zugriff auf Erinnerungen legt die App deine Einkaufsliste als Liste „Einkaufen“ mit echten Häkchen an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reminders access lets the app put your shopping list into a “Shopping” list with real checkboxes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con acceso a Recordatorios la app guarda tu lista de la compra en una lista «Comprar» con casillas de verdad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accès à Rappels permet de placer votre liste de courses dans une liste « Courses » avec de vraies cases à cocher."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con l’accesso a Promemoria l’app mette la lista della spesa in una lista «Spesa» con vere caselle di spunta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リマインダーへのアクセスで、買い物リストを本物のチェックボックスつきの「買うもの」リストに入れられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "미리 알림에 접근하면 장보기 목록을 진짜 체크박스가 있는 ‘장보기’ 목록으로 넣을 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com acesso aos Lembretes o app coloca sua lista de compras numa lista “Comprar” com caixas de seleção de verdade."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ к Напоминаниям нужен, чтобы складывать список покупок в список «Купить» с настоящими чекбоксами."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อเข้าถึงเตือนความจำได้ แอปจะใส่รายการซื้อของลงในรายการ “ซื้อของ” ที่มีช่องติ๊กจริง"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许访问提醒事项后，应用会把购物清单放进带真正勾选框的“购物”列表。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
